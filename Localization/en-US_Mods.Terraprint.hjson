Keybinds: {
	ToggleMenu.DisplayName: Open Terraprint menu
	Rotate.DisplayName: Rotate blueprint
	Flip.DisplayName: Mirror blueprint
	NudgeUp.DisplayName: Move blueprint up (menu open)
	NudgeDown.DisplayName: Move blueprint down (menu open)
	NudgeLeft.DisplayName: Move blueprint left (menu open)
	NudgeRight.DisplayName: Move blueprint right (menu open)
	AutoBuild.DisplayName: Hold to auto-build
}

Configs: {
	TerraprintConfig: {
		DisplayName: Terraprint Options

		Headers: {
			Capture: Capture (saving)
			Ghost: Ghost in the world
			Map: Map and minimap
			Colors: Colors
			General: General
			AutoBuild: Auto-build
			Blacklists: Blacklists
			Rendering: Rendering
			Layers: Layers
			Actuator: Actuator
		}

		CaptureLiquids: {
			Label: Save liquids
			Tooltip: Water, lava, honey and shimmer are saved in the blueprint.
		}

		CapturePaint: {
			Label: Save paint
			Tooltip: Block and wall paint are saved in the blueprint.
		}

		MaxBlueprintSize: {
			Label: Max area size
			Tooltip: Largest width or height, in tiles, that can be selected.
		}

		ShowGhost: {
			Label: Show ghost
			Tooltip: Draws the loaded blueprint over the world.
		}

		GhostOpacity: {
			Label: Ghost opacity
			Tooltip: How visible the ghost blocks are.
		}

		ShowWalls: {
			Label: Show walls
			Tooltip: Also draws and counts the blueprint walls.
		}

		ShowLiquids: {
			Label: Show liquids
			Tooltip: Draws the saved liquids (they don't count toward progress).
		}

		ShowCorrect: {
			Label: Highlight correct blocks
			Tooltip: Draws blocks already placed correctly in green. Off: they just disappear from the ghost.
		}

		MarkObstructions: {
			Label: Mark blocks to remove
			Tooltip: Shows a red X on solid blocks where the blueprint expects empty space.
		}

		CheckSlopes: {
			Label: Check slopes and half blocks
			Tooltip: A block with the wrong slope or half-block shape counts as wrong.
		}

		CheckPaint: {
			Label: Check paint
			Tooltip: A block or wall with different paint counts as wrong.
		}

		ShowOutline: {
			Label: Show outline
			Tooltip: Draws a golden rectangle around the blueprint.
		}

		ShowProgress: {
			Label: Show progress on screen
			Tooltip: Shows how many blocks are done at the top of the screen.
		}

		ShowOnMinimap: {
			Label: Show on minimap
			Tooltip: Also applies to the overlay map.
		}

		ShowOnFullscreenMap: {
			Label: Show on fullscreen map
			Tooltip: Hover it to see the progress.
		}

		MapOpacity: {
			Label: Map opacity
			Tooltip: How visible the blueprint is on the maps.
		}

		ColorMissing: {
			Label: Missing color
			Tooltip: Blocks still to be placed.
		}

		ColorWrong: {
			Label: Wrong color
			Tooltip: Different blocks or blocks to remove.
		}

		ColorCorrect: {
			Label: Correct color
			Tooltip: Blocks already correct (when highlighted).
		}

		ShowChatMessages: {
			Label: Chat messages
			Tooltip: Shows tips and confirmations in the chat. Warnings and errors always show.
		}

		CloseMenuOnLoad: {
			Label: Close menu when loading
			Tooltip: Closes the menu after clicking Load so you can place the blueprint right away.
		}

		PlacementAnchor: {
			Label: Mouse anchor
			Tooltip: Which point of the blueprint follows the mouse while moving it.
		}

		AutoBuildPerTick: {
			Label: Blocks per tick
			Tooltip: How many blocks auto-build places per tick (60 ticks = 1 second).
		}

		AutoBuildWalls: {
			Label: Place walls
			Tooltip: Auto-build also places the blueprint walls.
		}

		AutoBuildFurniture: {
			Label: Place furniture
			Tooltip: Auto-build also places furniture and other multi-tile objects.
		}

		AutoBuildSlopes: {
			Label: Apply slopes and half blocks
			Tooltip: Placed blocks get the same slope or half-block shape as the blueprint.
		}

		TileBlacklist: {
			Label: Ignored blocks
			Tooltip: Blocks and objects placed by these items are not shown in the ghost and do not count for progress, materials or auto build.
		}

		WallBlacklist: {
			Label: Ignored walls
			Tooltip: Walls placed by these items are ignored.
		}

		EnableBlinking: {
			Label: Blink the ghost
			Tooltip: Makes ghost blocks and walls blink.
		}

		TileBlinkDelay: {
			Label: Block blink delay
			Tooltip: Ticks between blinks (60 = 1 second).
		}

		WallBlinkDelay: {
			Label: Wall blink delay
			Tooltip: Ticks between blinks (60 = 1 second).
		}

		ShowTiles: {
			Label: Show block layer
			Tooltip: Draws the blueprint's blocks and objects.
		}

		ShowPaint: {
			Label: Show paint layer
			Tooltip: Mixes the saved paint color into the ghost.
		}

		ShowActuated: {
			Label: Show actuated blocks
			Tooltip: Draws actuated (turned off) blocks.
		}

		ActuatedOpacity: {
			Label: Actuated block opacity
			Tooltip: Opacity of actuated blocks in the ghost.
		}

		HighlightActuatorMismatch: {
			Label: Highlight actuator mismatch
			Tooltip: Orange border where the world's actuator differs from the blueprint.
		}

		ActuatorBorder: {
			Label: Actuator border thickness
			Tooltip: In pixels.
		}
	}

	Anchor: {
		BottomCenter: {
			Label: Bottom center
			Tooltip: ""
		}

		Center: {
			Label: Center
			Tooltip: ""
		}

		TopLeft: {
			Label: Top left
			Tooltip: ""
		}

		Tooltip: ""
	}
}

UI: {
	Title: Terraprint
	SaveHeader: Save a build
	NameHint: click to type
	SelectArea: Select area
	Save: Save
	FilesHeader: Saved blueprints
	Refresh: Refresh
	OpenFolder: Open folder
	NoFiles: No blueprints yet. Save an area in the tab next to this one.
	InfoFirstCorner: Click the first corner in the world (right click cancels).
	InfoSecondCorner: Click the opposite corner.
	InfoSelection: Selected area: {0} x {1} tiles
	InfoNoSelection: No area selected.
	SelectStart: "[Terraprint] Click the first corner of the area. Right click cancels."
	SelectSecond: "[Terraprint] Now click the opposite corner."
	SelectTooBig: "[Terraprint] Area too big ({0} x {1}). The limit is {2} per side (change it in the options)."
	SelectDone: "[Terraprint] Area selected: {0} x {1}. Give it a name and click Save."
	Cancelled: "[Terraprint] Cancelled."
	Saved: "[Terraprint] Saved {0} ({1} x {2})."
	SaveError: "[Terraprint] Could not save: {0}"
	ProjectionHeader: Projection
	NoProjection: No blueprint loaded. Open the saved blueprints tab and load one.
	ProjectionLine: "{0} ({1} x {2}), rotation {3}° {4}"
	Mirrored: (mirrored)
	StateMoving: Following the mouse: left click to place, right click to cancel.
	StateFixed: Placed. Use the arrows to adjust or Move to reposition.
	Rotate: Rotate
	Flip: Mirror
	Move: Move
	Remove: Remove
	NudgeHint: Move 1 tile (arrow keys too)
	Load: Load
	LoadError: "[Terraprint] Could not load {0}: {1}"
	PlacingStart: "[Terraprint] {0} loaded. Move the mouse and left click to place it. Use . to rotate and , to mirror."
	MovingStart: "[Terraprint] Move the mouse and left click to place. Right click returns to where it was."
	UnknownTypes: "[Terraprint] {0} block/wall types in this blueprint come from mods that are not loaded ({1}) and are left out of the ghost. Enable the mod to see them."
	UnknownTypesEditor: "[Terraprint] {0} block/wall types come from mods that are not loaded ({1}). They are hidden in the editor but stay in the file when you save (unless you place something over them)."
	RotateDropped: "[Terraprint] {0} furniture tiles did not fit after rotating and are hidden (furniture stays upright; only its position rotates)."
	Fixed: "[Terraprint] Blueprint placed at {0}, {1}. It stays saved with this world."
	Progress: "{0}: {1}/{2} ({3}%), missing {4}, wrong {5}"
	Options: Options
	ToggleGhost: Ghost: {0}
	ToggleMap: Map: {0}
	ToggleCorrect: Correct: {0}
	On: on
	Off: off
	Delete: Delete
	DeleteConfirm: Click again to delete
	Deleted: "[Terraprint] Deleted {0}."
	DeleteError: "[Terraprint] Could not delete: {0}"
	Materials: Materials
	MaterialsTitle: Materials
	MaterialsNone: No blueprint loaded.
	MaterialsDone: Everything is placed!
	MaterialsEnough: "{0} still to place. You have everything you need."
	MaterialsLacking: "{0} still to place. You are short of {1} items (in red)."
	ColNeeded: Total
	ColRemaining: Left
	ColHave: Have
	NoItem: "{0} (no item)"
	AutoBuild: Build (hold)
	AutoBuilding: Building...
	AutoBuildNothing: "[Terraprint] Nothing to place within reach: get closer, or you are missing the items (see Materials)."
	AutoBuildNoProjection: "[Terraprint] Place a blueprint first (load it and left click) to auto-build."
	SelectNotLoaded: "[Terraprint] Part of this area hasn't been loaded from the server yet. Walk near it and try again."
	Close: Close
	NameLabel: Name:
	FilesCount: "{0} blueprints. Load one to project it."
	TabCatalog: Blueprints
	NewBlueprint: Save new
	SaveHint: After saving, the blueprint shows up in the Blueprints tab with its preview.
	PreviewError: Could not read this file.
	FileInfo: "{0} x {1}  ·  {2} tiles"
	ModsUsed: "Mods: {0}"
	ModsMissing: "(not loaded: {0})"
	LoadHint: Double-click it in the list or press Load to project it in the world.
	Subtitle: Building blueprints
	PageLibrary: Library
	PageLibrarySub: Your saved builds. Click to pick, double-click to project.
	PageSave: Save area
	PageSaveSub: Copy a build from the world into a blueprint.
	PageProjection: Projection
	PageProjectionSub: The blueprint currently placed in the world.
	PageMaterials: Materials
	PageMaterialsSub: What is left to place and what you carry.
	PageOptions: Options
	PageOptionsSub: Changes apply right away and are saved.
	SearchHint: search...
	PaletteSearchHint: search item or mod...
	FromMod: "Mod: {0}"
	NewBlank: New blank
	NewBlankTip: Creates an empty blueprint and opens it in the editor.
	NewBlankName: New build
	Edit: Edit
	EditTip: Opens the schematic editor: place and remove blocks, walls, furniture and more.
	PickOne: Pick a blueprint.
	NoMatches: No blueprint matches that name.
	PreviewErrorShort: unreadable file
	DeleteConfirmShort: Confirm?
	Step1: Select the area
	Step2: Give it a name
	Step2Sub: If left empty, the date and time are used.
	Step3: Save it
	Selecting: Selecting...
	SaveFootnote: Tip: the maximum area size and what gets saved (liquids, paint) are in All options. Actuators and actuated blocks are saved too.
	GroupTransform: Transform
	GroupPosition: Position
	GroupView: View
	ShowGhostShort: Ghost in the world
	ShowMapShort: Show on map
	ShowCorrectShort: Show correct blocks
	AutoBuildTip: Hold to place the blocks in reach using your inventory.
	BuildAll: Build all
	BuildAllStop: Stop
	BuildAllTip: Places the whole blueprint using your inventory, no need to be nearby. Click again to stop.
	BuildAllStarted: "[Terraprint] Building the whole blueprint..."
	BuildAllDone: "[Terraprint] Build complete: {0} placed."
	BuildAllPartial: "[Terraprint] Build finished: {0} placed. {1} still missing (no item in your inventory or nothing to rest on) and {2} wrong (see Materials)."
	BuildAllStopped: "[Terraprint] Build stopped: {0} placed."
	GroupMovement: Movement
	NoClipShort: NoClip (pass through blocks)
	NoClipTip: Fly through blocks with WASD (jump goes up, Shift is faster). Handy to get out of a build.
	NoClipOn: "[Terraprint] NoClip on: fly with WASD, jump goes up, Shift is faster."
	NoClipOff: "[Terraprint] NoClip off."
	NoProjectionShort: No blueprint loaded
	StateMovingShort: Following the mouse: click to place
	ProgressBar: "{0}%  ·  {1}/{2} correct  ·  {3} missing  ·  {4} wrong"
	BadgeTitle: PROJECTION
	BadgeNone: None in the world
	BadgeMoving: moving
	Cancel: Cancel
	PickerTitle: Pick an item for the list
	ItemAddTip: Add item
	ItemRemoveTip:
		'''
		{0}
		Click to remove from the list
		'''
	ListEmpty: Nothing in the list.
	PaletteEmpty: Nothing found.
	CatBlocks: Blocks
	CatWalls: Walls
	CatFurniture: Furniture
	CatDecoration: Decoration
	CatEntities: Entities
	AllOptions: All options
	AllOptionsTip: Opens the mod config screen with everything (capture, colors, mouse anchor...).
	SecBlacklists: Blacklists
	SecRendering: Rendering
	SecLayers: Layers
	SecActuator: Actuator
	SecGhost: Ghost and map
	SecAutoBuild: Auto build
	OptTileBlacklist: Ignored blocks
	OptTileBlacklistTip: Blocks and objects placed by these items are ignored: they do not show in the ghost and do not count for progress, materials or auto build.
	OptWallBlacklist: Ignored walls
	OptWallBlacklistTip: Walls placed by these items are ignored (natural ones count too, e.g. Dirt Wall also ignores cave dirt walls).
	OptOpacity: Preview opacity
	OptOpacityTip: How visible the ghost is in the world.
	OptBlink: Blink the ghost
	OptBlinkTip: Makes ghost blocks and walls blink so they stand out from what is built.
	OptTileBlink: Block blink delay
	OptTileBlinkTip: Ticks between block blinks (60 = 1 second).
	OptWallBlink: Wall blink delay
	OptWallBlinkTip: Ticks between wall blinks (60 = 1 second).
	OptShowTiles: Block layer
	OptShowTilesTip: Draws the blueprint's blocks and objects.
	OptShowWalls: Wall layer
	OptShowWallsTip: Draws the blueprint's walls.
	OptShowPaint: Paint layer
	OptShowPaintTip: Mixes the saved paint color into the ghost.
	OptShowLiquids: Liquid layer
	OptShowLiquidsTip: Draws saved liquids (they do not count for progress).
	OptShowActuated: Show actuated blocks
	OptShowActuatedTip: Draws blocks that are actuated (turned off) in the blueprint.
	OptActuatedOpacity: Actuated block opacity
	OptActuatedOpacityTip: Actuated blocks are drawn darker and with this opacity.
	OptActuatorMismatch: Highlight actuator mismatch
	OptActuatorMismatchTip: Orange border where the world block's actuator (or on/off state) differs from the blueprint.
	OptActuatorBorder: Border thickness
	OptActuatorBorderTip: Thickness in pixels of the actuator mismatch border.
	OptShowCorrectTip: Draws already correct blocks in green. Off: they disappear from the ghost.
	OptShowCorrect: Highlight correct blocks
	OptObstructions: Mark blocks to remove
	OptObstructionsTip: Red X on solid blocks where the blueprint wants empty space.
	OptOutline: Gold outline
	OptOutlineTip: Rectangle around the blueprint in the world.
	OptProgress: Progress at top of screen
	OptProgressTip: Shows how many blocks are done.
	OptMinimap: Show on minimap
	OptMinimapTip: Also applies to the overlay map.
	OptFullMap: Show on fullscreen map
	OptFullMapTip: Hover it to see the progress.
	OptPerTick: Blocks per tick
	OptPerTickTip: How many blocks auto build places per tick (limited in multiplayer).
	OptBuildWalls: Place walls
	OptBuildWallsTip: Auto build also places walls.
	OptBuildFurniture: Place furniture
	OptBuildFurnitureTip: Auto build also places furniture and large objects.
	OptBuildSlopes: Apply slopes and actuators
	OptBuildSlopesTip: Blocks get the blueprint's slope or half block. Actuators are placed if you carry them.
	EditorTitle: Schematic editor
	EditorProject: Project
	EditorProjectTip: Saves and places this blueprint in the world.
	DiscardConfirm: Discard changes?
	EditorSaved: "[Terraprint] {0} saved."
	EditorLayer: Eraser layer
	LayerTiles: Blocks
	LayerWalls: Walls
	LayerTip: What the eraser and right click remove. Picking an item in the palette switches it.
	ToolBrush: Brush
	ToolBrushTip: Left places the item picked in the palette, right erases. Drag to paint.
	ToolRect: Rectangle
	ToolRectTip: Drag to fill a rectangle (right: erase the rectangle).
	ToolEraser: Eraser
	ToolEraserTip: Erases blocks or walls (see the layer). Furniture is removed whole.
	ToolPicker: Picker
	ToolPickerTip: Click a block to pick the same item in the palette.
	ToolHammer: Hammer
	ToolHammerTip: Click a block to cycle full, half block and slopes.
	ToolActuator: Actuator
	ToolActuatorTip: Left adds/removes an actuator; right toggles the block on/off (actuated).
	ToolPan: Hand
	ToolPanTip: Drag to move the view (the middle mouse button does it with any tool).
	Undo: Undo
	Redo: Redo
	ZoomTip: Zoom (or the mouse wheel over the grid)
	ZoomFit: Fit
	GrowBorders: Borders +4
	GrowBordersTip: Grows the area by 4 tiles on each side.
	TrimEmpty: Trim empty
	TrimEmptyTip: Removes empty rows and columns at the edges.
	EditorStatus: "{0} x {1}  ·  mouse: {2}  ·  item: {3}"
	EditorNothing: none
	EditorHelp: Wheel: zoom · middle: drag · Ctrl+Z / Ctrl+Y
}
